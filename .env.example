# ========================================
# ReachJobAI Environment Configuration
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ========================================
# Application Settings
# ========================================
APP_NAME=ReachJobAI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ========================================
# Database Configuration
# ========================================
# Local PostgreSQL example:
# DATABASE_URL=postgresql://username:password@localhost:5432/reachjobai

# Neon.tech (serverless PostgreSQL) example:
# DATABASE_URL=postgresql://user:pass@ep-xyz.region.aws.neon.tech/reachjobai?sslmode=require

# Leave empty to run without database (limited functionality)
DATABASE_URL=

# ========================================
# Security & Authentication
# ========================================
# IMPORTANT: Generate a strong secret key for production!
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-secret-change-in-production-use-strong-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# AI Integration (Google Gemini)
# ========================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# ========================================
# CORS Configuration
# ========================================
FRONTEND_URL=http://localhost:5173
# For multiple origins, use JSON array format:
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
